rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all direct client access.
    // All reads/writes go through server-side API routes using the Admin SDK,
    // which bypasses these rules. This is a defense-in-depth measure.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
