{
  "name": "web-annotator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n app,ai -c cyan,magenta \"npm:dev:app\" \"npm:local-ai\"",
    "dev:app": "next dev --hostname 127.0.0.1 --port 3000",
    "local-ai": "node scripts/local-ai.mjs",
    "cli-bridge": "npm run local-ai",
    "dev:with-cli": "npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.41",
    "@ai-sdk/react": "^3.0.86",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@saas-maker/ai": "file:/Users/sarthakagrawal/Desktop/saas-maker/packages/ai",
    "@saas-maker/changelog-widget": "^0.2.0",
    "@saas-maker/feedback": "^0.2.0",
    "@saas-maker/sdk": "^0.3.1",
    "@saas-maker/testimonials": "^0.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.11",
    "@xyflow/react": "^12.10.0",
    "ai": "^6.0.84",
    "class-variance-authority": "^0.7.0",
    "eventsource-parser": "^3.0.6",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "linkedom": "^0.18.12",
    "lucide-react": "^0.469.0",
    "next": "^16.0.7",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.624",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.3.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
