{
  "name": "web-annotator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n worker,spa,ai -c blue,green,magenta \"pnpm dev:worker\" \"pnpm dev:spa\" \"pnpm local-ai\"",
    "dev:spa": "vite",
    "dev:worker": "wrangler dev --config wrangler.local.toml",
    "local-ai": "node scripts/local-ai.mjs",
    "cli-bridge": "pnpm local-ai",
    "build": "node scripts/validate-env.mjs build && vite build",
    "cf:build": "pnpm build && pnpm --filter ./landing-astro build && node scripts/overlay-astro-landing.mjs",
    "preview": "vite preview",
    "deploy": "pnpm validate:env:deploy && pnpm cf:build && pnpm exec wrangler deploy --tag \"$(git rev-parse HEAD)\"",
    "lint": "biome check .",
    "type-check": "pnpm typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "validate:env:build": "node scripts/validate-env.mjs build",
    "validate:env:runtime": "node scripts/validate-env.mjs runtime",
    "validate:env:deploy": "node scripts/validate-env.mjs deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "memory:demo": "tsx scripts/memory-capture-demo.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.toml",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "migrate:firestore": "tsx scripts/migrate-firestore-to-d1.ts",
    "prepare": "husky",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:dev": "blume dev",
    "docs:build": "blume build",
    "knip": "knip --no-exit-code --reporter symbols",
    "knip:strict": "knip --reporter symbols"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.41",
    "@ai-sdk/react": "3.0.86",
    "@mozilla/readability": "0.6.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@saas-maker/feedback": "^0.2.1",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/react-query": "5.101.4",
    "@xyflow/react": "12.11.2",
    "ai": "6.0.168",
    "better-auth": "1.6.11",
    "class-variance-authority": "0.7.1",
    "drizzle-orm": "0.45.2",
    "eventsource-parser": "3.1.0",
    "hono": "4.12.32",
    "linkedom": "0.18.13",
    "lucide-react": "1.27.0",
    "pdfjs-dist": "5.4.624",
    "posthog-js": "^1.407.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-pdf": "10.4.1",
    "react-router-dom": "7.18.1",
    "remark-gfm": "4.0.1",
    "sanitize-html": "2.17.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@cloudflare/workers-types": "4.20260424.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "9.2.1",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "happy-dom": "20.11.1",
    "husky": "9.1.7",
    "knip": "^6.29.0",
    "lint-staged": "16.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": "1.9.0"
    }
  }
}
