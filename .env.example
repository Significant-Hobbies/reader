# free-ai-gateway auth key — required for /v1/* endpoints (Bearer token).
# Generate with: openssl rand -hex 32. Set as wrangler secret in all consumers.
AI_GATEWAY_API_KEY=

# free-ai-gateway — single AI chokepoint for the Fleet. Hosts the daily
# Neuron budget so we never exceed the 10k/day Workers AI free tier.
AI_BASE_URL=https://free-ai-gateway.sarthakagrawal927.workers.dev/v1
# AI_API_KEY is a legacy alias for AI_GATEWAY_API_KEY — prefer AI_GATEWAY_API_KEY
AI_API_KEY=

# Optional: local AI endpoint for local AI mode
LOCAL_AI_URL=http://127.0.0.1:3456

# --- Turso (libSQL) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- better-auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL better-auth uses for OAuth callbacks (e.g. http://localhost:3000 in
# dev, https://reader.sarthakagrawal927.workers.dev in prod).
BETTER_AUTH_URL=
# Google OAuth client credentials (GCP Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudflare R2 (PDF storage) ---
# Create R2 API token at: dash.cloudflare.com → R2 → Manage R2 API tokens
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=reader-pdfs

# --- Vite SPA (client-side, optional) ---
VITE_POSTHOG_KEY=
VITE_SAASMAKER_API_KEY=

# Recommended when running Playwright in serverless environments
# PLAYWRIGHT_BROWSERS_PATH=0
