NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Base64-encoded service account JSON (preferred for Vercel)
# macOS: base64 firebase-service-account.json | tr -d '\n'
# Linux: base64 -w0 firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_KEY=

# Optional: local path fallback instead of FIREBASE_SERVICE_ACCOUNT_KEY
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Optional: server-side fallback key for Vercel AI Gateway
AI_GATEWAY_API_KEY=

# Optional: local AI endpoint for local AI mode
LOCAL_AI_URL=http://127.0.0.1:3456

# Recommended when running Playwright in serverless environments
# PLAYWRIGHT_BROWSERS_PATH=0
