---
import '@/styles/landing.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  showStandaloneProjectStrip?: boolean;
  useAuthoredFooterHost?: boolean;
}

const {
  title,
  canonicalPath = '/',
  showStandaloneProjectStrip = true,
  useAuthoredFooterHost = false,
} = Astro.props;

const SITE_URL = 'https://read.significanthobbies.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f0eee6" />

    <title>{title}</title>
    <meta name="description" content={Astro.props.description} />
    <meta name="application-name" content="Reader" />

    <link rel="canonical" href={new URL(canonicalPath, SITE_URL)} />
    <link rel="alternate" type="text/markdown" href={new URL(canonicalPath === '/' ? '/index.md' : `${canonicalPath}.md`, SITE_URL)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(canonicalPath, SITE_URL)} />
    <meta property="og:site_name" content="Reader" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={Astro.props.description} />
    <meta property="og:image" content={`${SITE_URL}/reader-opengraph.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={Astro.props.description} />
    <meta name="twitter:image" content={`${SITE_URL}/reader-opengraph.png`} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Organization',
            '@id': `${SITE_URL}/#publisher`,
            name: 'Significant Hobbies',
            url: 'https://significanthobbies.com/',
            description: 'A family of maintained personal applications built around focused, private workflows.',
            logo: `${SITE_URL}/icon.svg`,
            founder: {
              '@type': 'Person',
              name: 'Sarthak Agrawal',
              url: 'https://sarthakagrawal.dev/',
            },
            sameAs: [
              'https://github.com/Significant-Hobbies',
              'https://github.com/Significant-Hobbies/reader',
            ],
          },
          {
            '@type': 'WebSite',
            '@id': `${SITE_URL}/#website`,
            name: 'Reader',
            url: SITE_URL,
            description: Astro.props.description,
            inLanguage: 'en',
            publisher: { '@id': `${SITE_URL}/#publisher` },
          },
        ],
      })}
    />
  </head>
  <body class="antialiased">
    <script
      is:inline
      defer
      src="https://health.sassmaker.com/tracker.js"
      data-key="ahk_pub_37a5218b0597ba297485ebf3da9494a7d60eebacbe5ed73de0160de77489ea5d"
      data-project="app-import-126da40da98ff062b1a644b460fe99614c95a45c614569ff8e76257f5610068d"
      data-identity="persistent"
    ></script>
    <slot />
    {showStandaloneProjectStrip && <portfolio-project-strip current-project="reader"></portfolio-project-strip>}
    <script
      is:inline
      src="https://sassmaker.com/project-strip.js?v=precise-b0adaa67"
      data-project="reader"
      data-host-only={useAuthoredFooterHost ? 'true' : undefined}
      data-theme="light"
      defer
    ></script>
    <script
      is:inline
      src="https://sassmaker.com/ai-chat-footer.js?v=precise-b0adaa67"
      data-name="Reader"
      data-project="reader"
      data-host-only={useAuthoredFooterHost ? 'true' : undefined}
      data-theme="light"
      data-art-src="/footer-art/reader-precise-original-v1.webp"
      defer
    ></script>
    <script is:inline type="module" src="https://sassmaker.com/newsletter-capture.js"></script>
    <style is:inline>
      fleet-footer-extension[data-fleet-footer-project="reader"] [data-fleet-footer-cta].closing {
        padding: 0;
        background: transparent;
        color: var(--ink);
        text-align: left;
      }
      fleet-footer-extension[data-fleet-footer-project="reader"] .closing-inner {
        max-width: none;
        margin: 0;
      }
      fleet-footer-extension[data-fleet-footer-project="reader"] .closing .section-index {
        color: var(--rust-dark);
      }
      fleet-footer-extension[data-fleet-footer-project="reader"] .closing h2 {
        margin: 0.35rem 0 0;
        font-size: clamp(1.2rem, 1.8vw, 1.65rem);
        line-height: 1.2;
      }
      fleet-footer-extension[data-fleet-footer-project="reader"] .closing p:not(.section-index) {
        margin: 0.65rem 0 0;
        color: var(--ink-soft);
      }
      fleet-footer-extension[data-fleet-footer-project="reader"] .closing .cta-row {
        justify-content: flex-start;
        margin-top: 1rem;
      }
      fleet-footer-extension[data-fleet-footer-project="reader"] .closing .btn-secondary {
        border-color: var(--ink);
        color: var(--ink);
      }
      fleet-footer-extension[data-fleet-footer-project="reader"] .closing .btn-secondary:hover {
        background: var(--night);
        color: var(--paper-light);
      }
      fleet-footer-extension[data-fleet-footer-project="reader"] .site-footer {
        display: flex;
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 0;
        flex-direction: column;
        gap: 1rem;
      }
      fleet-footer-extension[data-fleet-footer-project="reader"] .site-footer > div {
        min-width: 0;
      }
      fleet-footer-extension[data-fleet-footer-project="reader"] .site-footer nav {
        display: flex;
        width: 100%;
        flex-wrap: wrap;
        gap: 0.7rem 1rem;
      }
      fleet-footer-extension[data-fleet-footer-project="reader"] .site-footer nav a {
        max-width: 100%;
        overflow-wrap: anywhere;
      }
    </style>
    <script is:inline>
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest('[data-app-health-event]');
        const name = link?.getAttribute('data-app-health-event');
        if (!name || !window.appHealth || typeof window.appHealth.track !== 'function') return;
        window.appHealth.track(name);

        if (
          !(link instanceof HTMLAnchorElement) ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey ||
          link.target === '_blank' ||
          link.hasAttribute('download')
        ) return;

        event.preventDefault();
        let navigated = false;
        const navigate = () => {
          if (navigated) return;
          navigated = true;
          window.location.assign(link.href);
        };
        window.setTimeout(navigate, 5000);
        Promise.resolve(window.appHealth.flush?.()).catch(() => {}).finally(navigate);
      });
    </script>
  </body>
</html>
