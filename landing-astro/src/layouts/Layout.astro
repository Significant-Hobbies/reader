---
import Base from '@saas-maker/templates/Base.astro';
import { baseProps } from '@saas-maker/templates/page';
import type { WorkbenchContent } from '@saas-maker/templates/schema';
import Head from '@/components/Head.astro';

interface Props {
  content: WorkbenchContent;
}
const { content } = Astro.props;
---

<Base {...baseProps(content)} icon={undefined}>
  <Fragment slot="head">
    <!-- Shared head renders Microsoft Clarity (y6budslpbi) and App Health. -->
    <Head title={content.page.title} description={content.page.description ?? ''} templateHead />
  </Fragment>
  <slot />
</Base>
