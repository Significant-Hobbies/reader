---
import copy from '../../../../src/public-copy.json';
import PlainLayout from '@/layouts/PlainLayout.astro';
---
<PlainLayout title={copy.changelog.title} description={copy.changelog.description} canonicalPath="/changelog">
  <div class="page"><header class="header"><div class="header-inner"><a class="brand" href="/">Reader</a><a class="btn-signin" href="/library">Inbox</a></div></header>
  <main class="hero" style="display:block;max-width:48rem"><p class="eyebrow">Product direction</p><h1>{copy.changelog.heading}</h1>
    {copy.changelog.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <a class="btn-secondary" href="https://github.com/Significant-Hobbies/reader/commits/main">Source history ↗</a>
  </main><footer class="site-footer"><a href="/">Reader</a><a href="/privacy">Privacy</a></footer></div>
</PlainLayout>
